<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptor>
        <type>UDPv4</type>
        <interface_whitelist>
            <interface>192.168.10.1</interface>
        </interface_whitelist>
        <netmask_filter>ON</netmask_filter>
    </transport_descriptor>

    <participant profile_name="ds_client" is_default_profile="true">
        <rtps>
            <transports>
                <transport_id>
                    <transport_descriptor_ref>UDPv4</transport_descriptor_ref>
                </transport_id>
            </transports>
            <discovery>
                <server>
                    <metatrafficUnicastLocatorList>
                        <locator>
                            <udpv4>
                                <address>192.168.10.1</address>
                                <port>11811</port>
                            </udpv4>
                        </locator>
                    </metatrafficUnicastLocatorList>
                </server>
            </discovery>
        </rtps>
    </participant>
</profiles>
